# ─────────────────────────────────────────────────────────────
# SRE Memory Agent — environment template
# Copy to `.env` and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# ── LLM: Groq (agent reasoning, root cause, patch generation) ─
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model — tool calling + patch synthesis
GROQ_MODEL=openai/gpt-oss-120b
# Cheap/fast model — classification, summarisation, comparability checks
# NOTE: qwen/qwen3-32b is NOT served on every Groq plan. Check GET /openai/v1/models.
# The client auto-falls back to a known-good model and warns if this one is unavailable.
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Used automatically if the configured model is not served on this account.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# true = force the deterministic scripted LLM; makes no network calls at all.
LLM_OFFLINE=false
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90
LLM_JSON_MODE=true

# ── Hindsight: agent memory (REQUIRED for this project) ──────
# Cloud  → https://api.hindsight.vectorize.io  (set HINDSIGHT_API_KEY,
#          promo code MEMHACK99 = $50 credits, applied in billing AFTER registering)
# Local  → http://localhost:8888               (docker run ghcr.io/vectorize-io/hindsight:latest)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=sre:
HINDSIGHT_BANK_TEMPLATE=sre-incident
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=3000
HINDSIGHT_RECALL_TYPES=world,experience,observation
HINDSIGHT_PREFER_OBSERVATIONS=true
HINDSIGHT_INCLUDE_SOURCE_FACTS=true
HINDSIGHT_MEMORY_DEFENSE=true
HINDSIGHT_SEED_ON_STARTUP=true

# If self-hosting, the Hindsight server's own extraction LLM:
# docker run ... -e HINDSIGHT_API_LLM_PROVIDER=groq -e HINDSIGHT_API_LLM_API_KEY=<groq key>
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
# Groq rejects the default `service_tier: auto` on free/on-demand plans, which makes
# Hindsight's own extraction calls 400. `on_demand` is the value that works.
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
# Per-task overrides so Hindsight's own extraction/consolidation calls do not fall back
# to the rejected default tier. Read by the Hindsight server process, not by this app;
# `src/sre_agent/memory/embedded.py` sets these for the embedded server automatically.
# HINDSIGHT_API_RETAIN_LLM_EXTRA_BODY={"service_tier":"on_demand"}
# HINDSIGHT_API_CONSOLIDATION_LLM_EXTRA_BODY={"service_tier":"on_demand"}

# First start initialises embedded PostgreSQL and downloads embedding/reranker models.
HINDSIGHT_START_TIMEOUT=300
# Retry instead of losing a memory when the provider rate limits us (HTTP 429).
MEMORY_QUOTA_MAX_RETRIES=3
MEMORY_QUOTA_MAX_WAIT_SECONDS=90

# ── Hindsight Cloud (alternative to a local server) ──────────
# Instead of running a server yourself, set:
#   HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
#   HINDSIGHT_API_KEY=<key from ui.hindsight.vectorize.io>
# Cloud is not subject to your local Groq plan's per-minute token ceiling, which a free
# Groq tier hits quickly (~8k TPM) once retain and reflect both run per incident.

# ── Error coverage / taxonomy ────────────────────────────────
# The classifier assigns every failure a class. Specialists add extra tools,
# prompts and required evidence. Everything else falls through the generic loop.
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=openai/gpt-oss-20b
CLASSIFIER_MIN_CONFIDENCE=0.6
SPECIALIST_CLASSES=connection-exhaustion,config-regression
# Classes code cannot fix: classify, then escalate instead of patching.
ESCALATE_CLASSES=auth-credential,infrastructure,unknown
GENERIC_FALLBACK_ENABLED=true

# ── Code review gate (runs BEFORE sandbox execution) ─────────
CODE_REVIEW_ENABLED=true
POLICY_REVIEW_ENABLED=true          # deterministic: paths, size, secrets, forbidden imports
CONVENTIONS_REVIEW_ENABLED=true     # LLM, checked against convention memory
CODE_REVIEW_MODEL=openai/gpt-oss-120b
MAX_REVIEW_CYCLES=2                 # revise loops; does NOT consume a repair attempt
REVIEW_BLOCK_SEVERITY=high          # block execution on findings >= this severity
REVIEW_REQUIRE_ROOTCAUSE=true       # reject symptom-only patches

# ── Convention memory (second Hindsight bank) ────────────────
CONVENTION_MEMORY_ENABLED=true
CONVENTION_BANK_SUFFIX=:conventions
CONVENTION_SEED_PATH=./config/conventions.py

# ── Regression detection ─────────────────────────────────────
REGRESSION_CHECK_ENABLED=true
REGRESSION_SUITE=full               # full | failing-only
REGRESSION_BASELINE=last-known-good
REGRESSION_MAX_NEW_FAILURES=0
REGRESSION_FLAKE_RERUNS=2           # distinguishes flake from real regression
REGRESSION_BLAST_RADIUS_CHECK=true

# ── Agent recovery budget / safety rails ─────────────────────
MAX_REPAIR_ATTEMPTS=3
MAX_LLM_CALLS_PER_INCIDENT=40
MAX_INCIDENT_SECONDS=600
PATCH_MAX_FILES=5
PATCH_MAX_LINES=200
PATCH_MIN_CONFIDENCE=0.5
ALLOWED_PATCH_PATHS=src/,app/,config/,tests/
FORBIDDEN_PATCH_PATHS=.github/,infra/,migrations/,secrets/
REQUIRE_APPROVAL_FOR_ROLLBACK=false
REQUIRE_APPROVAL_FOR_DEPLOY=false

# ── Sandbox (isolated fix execution) ─────────────────────────
# auto → Docker when the daemon is reachable, otherwise the local temp-workspace backend
# (which needs no daemon and is what CI and this dev machine use).
SANDBOX_BACKEND=auto
# Built from docker/sandbox.Dockerfile by the command in the README. `python:3.12-slim` is
# that Dockerfile's base image, not the sandbox — it has no pytest, so every suite would fail.
SANDBOX_IMAGE=sre-memory-agent/sandbox:pytest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_NETWORK=none
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPUS=2
# Stream the workspace into the container rather than bind-mounting it. Required when the
# daemon cannot see this filesystem, and safer everywhere else. A remote DOCKER_HOST forces it.
SANDBOX_COPY_REPO=true

# ── Sandbox on a remote daemon ───────────────────────────────
# Where a daemon cannot run (a Hugging Face Space, for one) the sandbox can still have
# container isolation by pointing the Docker CLI at a daemon elsewhere — these are the CLI's
# own variables, used as-is:
#   DOCKER_HOST=ssh://user@your-host
#       Simplest: no certificates to manage, the CLI uses your SSH key. On a Space, add the
#       private key as a secret and the entrypoint writes it to ~/.ssh with mode 600.
#   DOCKER_HOST=tcp://your-host:2376  +  DOCKER_TLS_VERIFY=1  +  DOCKER_CERT_PATH=<dir>
#       Requires ca.pem/cert.pem/key.pem in that directory. On a Space, set DOCKER_CA_CERT,
#       DOCKER_CLIENT_CERT and DOCKER_CLIENT_KEY to the file contents instead; the entrypoint
#       writes them out and points DOCKER_CERT_PATH at them.
# Either way, build the sandbox image on the daemon first:
#   docker build -f docker/sandbox.Dockerfile -t sre-memory-agent/sandbox:pytest docker/
# DOCKER_HOST=ssh://user@your-host

# ── Target repo under repair ─────────────────────────────────
DEMO_REPO_PATH=./demo/redis-worker-app
DEMO_BRANCH=main
GIT_LAST_KNOWN_GOOD_REF=origin/main
GIT_AUTHOR_NAME=sre-memory-agent

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/agent.db
RUNS_DIR=./data/runs
RUNBOOK_DIR=./data/runbook

# ── Demo reliability ─────────────────────────────────────────
# true = re-render recorded trajectories, no LLM/Hindsight calls.
# Flip this on if the network or rate limits die in front of judges.
DEMO_REPLAY_MODE=false
DEMO_RECORD_TRAJECTORIES=true
